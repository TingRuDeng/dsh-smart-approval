{
  "name": "dsh-smart-approval",
  "version": "0.1.0-rc.12",
  "description": "Fail-closed LLM-assisted approval reviewer for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run test && pnpm run build",
    "release:preview": "node scripts/release-preview.mjs",
    "release:formal": "node scripts/release-preview.mjs --formal",
    "prepublishOnly": "pnpm run check",
    "prepare": "pnpm run build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "approval",
    "security"
  ],
  "license": "MIT",
  "author": "JimDeng891 <dengm891@yeah.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TingRuDeng/dsh-smart-approval.git"
  },
  "homepage": "https://github.com/TingRuDeng/dsh-smart-approval#readme",
  "bugs": {
    "url": "https://github.com/TingRuDeng/dsh-smart-approval/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "~0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "~0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-locale": "~0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "~0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "~0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "~0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "~0.2.1-alpha.2",
    "@deepseek-ai/dsh-commands": "~0.2.1-alpha.2",
    "@deepseek-ai/dsh-fs": "~0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "~0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "~0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-projection": "~0.2.1-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "~0.2.1-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "~0.2.1-alpha.2",
    "@deepseek-ai/dsh-user-approval": "~0.2.1-alpha.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:../deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-api-remotes": "link:../deepseek-harness/packages/api/remotes",
    "@deepseek-ai/dsh-client-locale": "link:../deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../deepseek-harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-session": "link:../deepseek-harness/packages/client/ui-session",
    "@deepseek-ai/dsh-client-ui-slots": "link:../deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-commands": "link:../deepseek-harness/packages/interaction/commands",
    "@deepseek-ai/dsh-fs": "link:../deepseek-harness/packages/fs/fs",
    "@deepseek-ai/dsh-llm": "link:../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-permission-presets": "link:../deepseek-harness/packages/interaction/permission-presets",
    "@deepseek-ai/dsh-session": "link:../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-session-projection": "link:../deepseek-harness/packages/session/session-projection",
    "@deepseek-ai/dsh-storage": "link:../deepseek-harness/packages/storage/storage",
    "@deepseek-ai/dsh-storage-domain": "link:../deepseek-harness/packages/storage/storage-domain",
    "@deepseek-ai/dsh-storage-json": "link:../deepseek-harness/packages/storage/storage-json",
    "@deepseek-ai/dsh-typert-protocol": "link:../deepseek-harness/packages/typert/protocol",
    "@deepseek-ai/dsh-user-approval": "link:../deepseek-harness/packages/interaction/user-approval",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "jsdom": "29.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
