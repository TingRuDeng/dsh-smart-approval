{
  "name": "dsh-smart-approval",
  "version": "0.1.0-rc.2",
  "description": "Fail-closed LLM-assisted approval reviewer for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run test && pnpm run build",
    "prepublishOnly": "pnpm run check",
    "prepare": "pnpm run build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "approval",
    "security"
  ],
  "license": "MIT",
  "author": "JimDeng891 <dengm891@yeah.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TingRuDeng/dsh-smart-approval.git"
  },
  "homepage": "https://github.com/TingRuDeng/dsh-smart-approval#readme",
  "bugs": {
    "url": "https://github.com/TingRuDeng/dsh-smart-approval/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-permission-presets": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.5 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-permission-presets": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.6",
    "@types/node": "^24.13.3",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
